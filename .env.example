TILLER_ADMIN_USERNAME=admin
TILLER_ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional: admin session lifetime (Go duration). Defaults to 720h (30 days).
# TILLER_ADMIN_SESSION_TTL=720h
# The app starts as root and drops to TILLER_RUN_UID/TILLER_RUN_GID at boot,
# chown'ing ./data to that user first — so a fresh ./data needs no manual
# chmod/chown. Defaults to 65532:65532 to match the image's build args.
TILLER_RUN_UID=65532
TILLER_RUN_GID=65532
# TILLER_UID/TILLER_GID are build-time args that set the ownership of the
# baked-in files inside the image. You normally don't need to change these.
TILLER_UID=65532
TILLER_GID=65532
# The Compose service listens on container port 8080 and stores all persistent
# state in the bind-mounted ./data directory.
# Optional: set to the reverse proxy's IP/CIDR to trust its forwarded
# client/scheme headers. Forwarded headers are accepted only when the direct
# peer is inside this CIDR. Leave unset to disable proxy-header trust.
# TILLER_TRUSTED_PROXY=172.16.0.0/12
# Docker Compose deliberately publishes on all host interfaces. Use the host
# firewall or a private network when direct LAN/WAN access is not intended.
TILLER_PORT=8080
# Optional: models.dev capability-metadata fallback (true/false). Defaults to true.
# TILLER_MODELS_DEV_ENABLED=true
