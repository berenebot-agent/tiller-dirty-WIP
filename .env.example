TILLER_ADMIN_USERNAME=admin
TILLER_ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional: admin session lifetime (Go duration). Defaults to 720h (30 days).
# TILLER_ADMIN_SESSION_TTL=720h
TILLER_UID=65532
TILLER_GID=65532
# The Compose service listens on container port 8080 and stores all persistent
# state in the bind-mounted ./data directory.
TILLER_TRUST_PROXY_HEADERS=false
# Optional: required when proxy-header trust is true. Forwarded client/scheme
# headers are accepted only when the direct peer is in this CIDR.
# TILLER_TRUSTED_PROXY=172.16.0.0/12
# Docker Compose deliberately publishes on all host interfaces. Use the host
# firewall or a private network when direct LAN/WAN access is not intended.
TILLER_PORT=8080
# Optional: models.dev capability-metadata fallback (true/false). Defaults to true.
# TILLER_MODELS_DEV_ENABLED=true
